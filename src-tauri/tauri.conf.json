{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typeleft",
  "version": "0.9.0",
  "identifier": "com.typeleft.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typeleft",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkdn",
          "mkd",
          "mdwn"
        ],
        "mimeType": "text/markdown",
        "name": "markdown",
        "description": "Markdown File",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "mdtxt",
          "text",
          "mdtext"
        ],
        "mimeType": "text/plain",
        "name": "text",
        "description": "Text File",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
